#!/bin/sh
set -eu

if [ "${VFOX_RUST_ACTIVE:-}" != "1" ]; then
    if command -v vfox >/dev/null 2>&1; then
        exec vfox exec rust@1.98.0 -- env VFOX_RUST_ACTIVE=1 sh "$0" "$@"
    fi

    exec "$@"
fi

if [ -z "${CARGO_HOME:-}" ]; then
    printf '%s\n' 'vfox Rust environment is incomplete: CARGO_HOME is not set.' >&2
    exit 1
fi

sdk=$(dirname "$CARGO_HOME")
rustc_lib="$sdk/rustc/lib"
if [ ! -d "$rustc_lib" ]; then
    printf '%s\n' "vfox Rust environment is incomplete: expected Rust libraries at $rustc_lib." >&2
    exit 1
fi

case "$(uname -s)" in
    Darwin)
        export DYLD_FALLBACK_LIBRARY_PATH="$rustc_lib${DYLD_FALLBACK_LIBRARY_PATH:+:$DYLD_FALLBACK_LIBRARY_PATH}"
        ;;
    Linux)
        export LD_LIBRARY_PATH="$rustc_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        ;;
esac

exec "$@"
