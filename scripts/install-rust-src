#!/bin/sh
set -eu

version=1.98.0
archive="rust-src-$version.tar.xz"
url="https://static.rust-lang.org/dist/$archive"
expected_sha256='0e977492aed5ff137815bf9b4b796e8a85b80fb2367ed64e82d5c5839870f2bf'

if ! command -v vfox >/dev/null 2>&1; then
    printf '%s\n' 'vfox is required to install rust-src for the pinned Rust SDK.' >&2
    exit 1
fi

sysroot=$(sh scripts/vfox-rust rustc --print sysroot)
library="$sysroot/lib/rustlib/src/rust/library"
if [ -d "$library" ]; then
    exit 0
fi

case "$sysroot" in
    */rustc) ;;
    *)
        printf '%s\n' "unexpected Rust sysroot layout: $sysroot" >&2
        exit 1
        ;;
esac

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT HUP INT TERM
archive_path="$tmpdir/$archive"

curl --fail --location --silent --show-error "$url" --output "$archive_path"
actual_sha256=$(shasum -a 256 "$archive_path" | awk '{print $1}')
if [ "$actual_sha256" != "$expected_sha256" ]; then
    printf '%s\n' "rust-src checksum mismatch: expected $expected_sha256, got $actual_sha256" >&2
    exit 1
fi

if ! tar -tJf "$archive_path" | grep -Fxq "rust-src-$version/install.sh"; then
    printf '%s\n' 'unexpected rust-src archive layout.' >&2
    exit 1
fi

tar -xJf "$archive_path" -C "$tmpdir"
installer=$(printf '%s\n' "$tmpdir"/rust-src-*/install.sh)
[ -f "$installer" ] || {
    printf '%s\n' 'rust-src installer was not found after extraction.' >&2
    exit 1
}
sh "$installer" --prefix="$sysroot"

[ -d "$library" ] || {
    printf '%s\n' "rust-src installation did not create $library." >&2
    exit 1
}
