{
  "rust-analyzer": {
    "command": "rust-analyzer",
    "args": [],
    "fileTypes": [".rs"],
    "languageId": "rust",
    "rootMarkers": ["Cargo.toml"],
    "initOptions": {
      "cargo": {
        "allTargets": true,
        "buildScripts": {
          "enable": true
        }
      },
      "procMacro": {
        "enable": true
      },
      "check": {
        "command": "clippy",
        "extraArgs": ["--all-targets", "--all-features"]
      }
    }
  }
}
